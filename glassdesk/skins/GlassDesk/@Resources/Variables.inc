[Variables]
; Size multiplier for boxes and shapes. Surface Pro 8 runs at 200% scaling, so 2.
; Everything too big? Try 1.5. Too small? Try 2.5.
Scale=2
; Size multiplier for text. If text looks too big or too small inside its box,
; change only this one (try 1 or 2.5).
FontScale=2

Font=Segoe UI Variable Display
Glass=255,255,255,40
GlassEdge=255,255,255,85
Text=255,255,255,240
TextDim=255,255,255,160
Radius=22

; Weather: leave blank to detect your city from your internet connection,
; or type a city, e.g. WeatherLocation=Atlanta
WeatherLocation=
; u = Fahrenheit, m = Celsius
WeatherUnits=u

; World clocks. Offset = standard-time hours from UTC.
; DST rule: US, EU, AU or NONE.
Clock1Name=Los Angeles
Clock1Offset=-8
Clock1DST=US
Clock2Name=New York
Clock2Offset=-5
Clock2DST=US
Clock3Name=London
Clock3Offset=0
Clock3DST=EU
Clock4Name=Tokyo
Clock4Offset=9
Clock4DST=NONE
