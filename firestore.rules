rules_version = '2';

// All reads and writes go through Cloud Functions (Admin SDK), which
// bypass these rules. Direct client access to Firestore is disabled so
// the daily limit and secretary-only actions can't be bypassed from
// the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
