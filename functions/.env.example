# Copy to functions/.env (created automatically by `npm run setup`).
# Timezone used to compute "today" for the daily request limit.
TIMEZONE=America/Chicago

# Used only the very first time settings/general is read (before the
# secretary changes the limit from her dashboard).
DAILY_LIMIT_DEFAULT=8

# Where new requests get emailed. Can also be changed later by editing
# the settings/general document directly in Firestore.
SECRETARY_EMAIL=
SECRETARY_NAME=

# EmailJS (https://dashboard.emailjs.com) sends the actual emails — no
# SMTP credentials to manage. Email Services -> your connected inbox for
# the Service ID; Email Templates for the Template IDs; Account -> General
# for the Public Key; Account -> API Keys for the Private Key.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Template that notifies the secretary of a new request (required for email delivery).
EMAILJS_SECRETARY_TEMPLATE_ID=
# Template that confirms receipt to the requester (optional — leave blank to skip).
EMAILJS_REQUESTER_TEMPLATE_ID=
